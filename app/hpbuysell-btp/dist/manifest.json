{
	"_version": "1.90.0",
	"sap.app": {
		"id": "hpbuysellbtp",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:lrop",
			"version": "1.34.0",
			"toolsId": "6e19e419-3bf1-4854-90a2-86b01c7f2546"
		},
		"crossNavigation": {
			"inbounds": {
				"BannerMaintenance-manage": {
					"semanticObject": "BannerMaintenance",
					"action": "manage",
					"title": "Banner Maintenance",
					"subtitle": "Manage Downtime Banners",
					"icon": "sap-icon://message-warning",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		},
		"dataSources": {
			"mainService": {
				"uri": "BannerService/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"dependencies": {
			"minUI5Version": "1.154.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.fe.templates": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "hpbuysellbtp.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"@i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties",
				"settings": {
					"supportedLocales": [
						""
					]
				}
			}
		},
		"extends": {
			"extensions": {
				"sap.ui.controllerExtensions": {
					"sap.fe.templates.ListReport.ListReportController": {
						"controllerName": "hpbuysellbtp.ext.controller.ListReportExt"
					},
					"sap.fe.templates.ObjectPage.ObjectPageController": {
						"controllerName": "hpbuysellbtp.ext.controller.ObjectPageExt"
					}
				}
			}
		},
		"resources": {
			"css": []
		},
		"routing": {
			"config": {},
			"routes": [
				{
					"pattern": ":?query:",
					"name": "BannersList",
					"target": "BannersList"
				},
				{
					"pattern": "Banners({key}):?query:",
					"name": "BannersObjectPage",
					"target": "BannersObjectPage"
				}
			],
			"targets": {
				"BannersList": {
					"type": "Component",
					"id": "BannersList",
					"name": "sap.fe.templates.ListReport",
					"options": {
						"settings": {
							"contextPath": "/Banners",
							"variantManagement": "Page",
							"navigation": {
								"Banners": {
									"detail": {
										"route": "BannersObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable"
									},
									"columns": {
										"ContentIcon": {
											"header": "Content",
											"position": {
												"anchor": "DataField::modifiedAt",
												"placement": "After"
											},
											"template": "hpbuysellbtp.ext.fragment.ContentIcon",
											"properties": [
												"content",
												"bannerName"
											]
										}
									}
								}
							}
						}
					}
				},
				"BannersObjectPage": {
					"type": "Component",
					"id": "BannersObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/Banners",
							"content": {
								"header": {
									"actions": {
										"RefreshAction": {
											"press": ".extension.hpbuysellbtp.ext.controller.ObjectPageExt.onRefresh",
											"text": "Refresh",
											"icon": "sap-icon://refresh",
											"enabled": true,
											"visible": true
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"flexBundle": false
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.fe": {
		"app": {
			"enableLazyLoading": true
		}
	},
	"sap.cloud": {
		"public": true,
		"service": "hpbuysell.btp.maintenance"
	}
}